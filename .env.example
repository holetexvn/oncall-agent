# ---- Claude Code ----
# Một trong hai: token từ `claude setup-token` (thuê bao) hoặc API key (Console)
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# Client Secret của Internal Integration (Settings -> Developer Settings)
SENTRY_CLIENT_SECRET=
SENTRY_DSN=
# Fine-grained token: chỉ Contents:write + Pull requests:write trên repo demo. KHÔNG cấp admin, KHÔNG cấp push lên main (bảo vệ branch main).
GH_TOKEN=
REPO_DIR=/srv/demo-app
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MAX_BUDGET_USD=1.50
MAX_TURNS=20
RECEIVER_PORT=8080
LOG_DIR=/var/log/demo-app
TRIGGER_MIN_USERS=3
TRIGGER_MIN_EVENTS=3
TRIGGER_WINDOW_MIN=30
GH_REPO=holetexvn/oncall-agent

# demo-app tự báo lỗi vào receiver khi chưa có Sentry (bỏ trống nếu đã dùng Sentry)
RECEIVER_URL=http://127.0.0.1:8080/webhook/sentry
